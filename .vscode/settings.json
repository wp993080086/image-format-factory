{
  // 统一换行符为 LF（与 .gitattributes 保持一致）
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  // Dart/Flutter 保存时格式化
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.rulers": [80]
  },
  "dart.flutterSdkPath": null,
  "dart.runPubGetOnPubspecChanges": "always",
  "workbench.colorCustomizations": {
    "activityBar.activeBackground": "#413e3e",
    "activityBar.background": "#413e3e",
    "activityBar.foreground": "#e7e7e7",
    "activityBar.inactiveForeground": "#e7e7e799",
    "activityBarBadge.background": "#308f30",
    "activityBarBadge.foreground": "#e7e7e7",
    "commandCenter.border": "#e7e7e799",
    "statusBar.background": "#272525",
    "statusBar.foreground": "#e7e7e7",
    "statusBarItem.hoverBackground": "#413e3e",
    "statusBarItem.remoteBackground": "#272525",
    "statusBarItem.remoteForeground": "#e7e7e7",
    "tab.activeBorder": "#413e3e",
    "titleBar.activeBackground": "#272525",
    "titleBar.activeForeground": "#e7e7e7",
    "titleBar.inactiveBackground": "#27252599",
    "titleBar.inactiveForeground": "#e7e7e799",
    "activityBarTop.activeBackground": "#272525",
    "activityBarTop.background": "#272525",
    "activityBarTop.foreground": "#15202b",
    "activityBarTop.inactiveForeground": "#15202b99",
    "commandCenter.foreground": "#15202b"
  },
  "peacock.color": "#272525"
}
